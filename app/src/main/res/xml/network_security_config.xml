<?xml version="1.0" encoding="utf-8"?>
<!--
  The Arch Linux ARM image is served over plain HTTP and redirects to a plain-HTTP
  mirror, so cleartext has to be allowed for that domain or the rootfs download
  fails outright on API 28+. Everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">archlinuxarm.org</domain>
    </domain-config>
</network-security-config>
