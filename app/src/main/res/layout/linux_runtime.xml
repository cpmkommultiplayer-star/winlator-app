<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/px_deep"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="LINUX RUNTIME"
            android:textColor="@color/px_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/BTLinuxBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/px_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:text="BACK"
            android:textColor="@color/px_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/TVLinuxStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/px_panel"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:text="NOT INSTALLED"
        android:textColor="@color/px_text"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/PBLinux"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/px_hot"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/BTLinuxInstall"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/px_badge"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="INSTALL 830 MB"
            android:textColor="@color/px_deep"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/BTLinuxTest"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:alpha="0.4"
            android:background="@drawable/px_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="RUN TEST"
            android:textColor="@color/px_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/TVLinuxLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/px_panel"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/px_text_dim"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>
</LinearLayout>
