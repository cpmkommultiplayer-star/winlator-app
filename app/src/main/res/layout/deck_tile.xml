<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="186dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/px_panel"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/IVTileIcon"
        android:layout_width="170dp"
        android:layout_height="96dp"
        android:contentDescription="Game icon"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/TVTileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:textColor="@color/px_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TVTileMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textColor="@color/px_text_dim"
        android:textSize="8sp" />
</LinearLayout>
