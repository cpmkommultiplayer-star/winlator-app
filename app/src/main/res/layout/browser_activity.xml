<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/px_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/px_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="2dp"
            android:paddingStart="2dp">

            <HorizontalScrollView
                android:id="@+id/SCTabStrip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/LTabStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/BTNewTab"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_new_tab"
                android:padding="7dp"
                android:src="@drawable/px_plus"
                android:tint="@color/px_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/px_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            android:paddingEnd="3dp"
            android:paddingStart="3dp"
            android:paddingTop="3dp">

            <ImageButton
                android:id="@+id/BTBrowserBack"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_back"
                android:padding="8dp"
                android:src="@drawable/browser_back"
                android:tint="@color/px_text_dim" />

            <ImageButton
                android:id="@+id/BTBrowserForward"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_forward"
                android:padding="8dp"
                android:src="@drawable/browser_forward"
                android:tint="@color/px_text_dim" />

            <EditText
                android:id="@+id/ETBrowserAddress"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/px_field"
                android:gravity="center_vertical"
                android:hint="@string/browser_address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/px_text"
                android:textColorHint="@color/px_line"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/BTBrowserReload"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_reload"
                android:padding="8dp"
                android:src="@drawable/browser_reload"
                android:tint="@color/px_accent" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/PBrowserLoad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/px_hot"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.mozilla.geckoview.GeckoView
                android:id="@+id/GVContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include layout="@layout/browser_find_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" />

            <include layout="@layout/browser_downloads_panel" android:layout_width="match_parent" android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/LMenuPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:background="@drawable/px_panel"
                android:orientation="vertical"
                android:padding="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/px_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/browser_menu_title"
                        android:textAllCaps="true"
                        android:textColor="@color/px_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/BTMenuClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/px_button"
                        android:contentDescription="@string/browser_close"
                        android:padding="9dp"
                        android:src="@drawable/px_close"
                        android:tint="@color/px_hot" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/LMenuRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/px_bar"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/BTBHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_home"
                android:padding="13dp"
                android:src="@drawable/px_home"
                android:tint="@color/px_text_dim" />

            <ImageButton
                android:id="@+id/BMenuDownloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_action_downloads"
                android:padding="13dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/BTBDownloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_action_downloads"
                android:padding="13dp"
                android:src="@drawable/px_download"
                android:tint="@color/px_text_dim" />

            <ImageButton
                android:id="@+id/BTBFind"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_action_find"
                android:padding="13dp"
                android:src="@drawable/px_find"
                android:tint="@color/px_text_dim" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/BTBTabs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/px_button"
                    android:contentDescription="@string/browser_new_tab"
                    android:padding="13dp"
                    android:src="@drawable/px_tabs"
                    android:tint="@color/px_text_dim" />

                <TextView
                    android:id="@+id/TVTabsCount"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/px_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/px_deep"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/BTBMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:contentDescription="@string/browser_menu"
                android:padding="13dp"
                android:src="@drawable/px_menu"
                android:tint="@color/px_accent" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
