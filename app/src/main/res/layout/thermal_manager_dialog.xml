<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/FieldSet">

            <TextView
                android:id="@+id/TVThermalNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVThermalBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxHeight="190dp">

                <TextView
                    android:id="@+id/TVThermalSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout style="@style/FieldSet">

            <CheckBox
                android:id="@+id/CBThermalProtection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/thermal_protection" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thermal_warn_threshold" />

            <Spinner
                android:id="@+id/SPThermalWarn"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thermal_critical_threshold" />

            <Spinner
                android:id="@+id/SPThermalCritical"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
